{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeirdClausesReport",
  "description": "Schema for WeirdClauses contract analysis and clause surprisal reports",
  "type": "object",
  "required": [
    "version",
    "disclaimer",
    "document",
    "models",
    "summary",
    "clauses",
    "key_facts"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "WeirdClauses tool version"
    },
    "disclaimer": {
      "type": "string",
      "description": "Mandatory legal disclaimer stating WeirdClauses is not legal advice"
    },
    "document": {
      "type": "object",
      "required": ["file_name", "char_count", "clause_count", "sha256"],
      "additionalProperties": true,
      "properties": {
        "file_path": { "type": ["string", "null"] },
        "file_name": { "type": "string" },
        "char_count": { "type": "integer", "minimum": 0 },
        "clause_count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      }
    },
    "models": {
      "type": "object",
      "required": ["lm_model", "embed_model", "mode", "aggregator"],
      "additionalProperties": true,
      "properties": {
        "lm_model": { "type": "string" },
        "embed_model": { "type": "string" },
        "device": { "type": ["string", "null"] },
        "mode": { "type": "string" },
        "aggregator": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_clauses", "scored_clauses", "key_facts_count"],
      "additionalProperties": true,
      "properties": {
        "total_clauses": { "type": "integer", "minimum": 0 },
        "scored_clauses": { "type": "integer", "minimum": 0 },
        "key_facts_count": { "type": "integer", "minimum": 0 },
        "mean_score": { "type": ["number", "null"] },
        "max_score": { "type": ["number", "null"] }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "start", "end", "kind", "facts"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "integer" },
          "text": { "type": "string" },
          "content": { "type": ["string", "null"] },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string", "enum": ["clause", "heading", "frame"] },
          "parent_heading": { "type": ["string", "null"] },
          "rank": { "type": ["integer", "null"] },
          "score": { "type": ["number", "null"] },
          "z_score": { "type": ["number", "null"] },
          "raw_surprisal": { "type": ["number", "null"] },
          "conditional_surprisal": { "type": ["number", "null"] },
          "nearest_similarity": { "type": ["number", "null"] },
          "gain": { "type": ["number", "null"] },
          "nearest_matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "topic", "similarity"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "topic": { "type": "string" },
                "similarity": { "type": "number" },
                "summary": { "type": "string" }
              }
            }
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "bits"],
              "additionalProperties": true,
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 },
                "bits": { "type": "number" }
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value", "start", "end", "source_label"],
              "additionalProperties": true,
              "properties": {
                "kind": { "type": "string" },
                "value": { "type": "string" },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 },
                "source_label": { "type": "string", "enum": ["rule-based"] }
              }
            }
          }
        }
      }
    },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_id", "kind", "value", "start", "end", "source_label"],
        "additionalProperties": true,
        "properties": {
          "clause_id": { "type": ["integer", "null"] },
          "kind": { "type": "string" },
          "value": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "source_label": { "type": "string", "enum": ["rule-based"] }
        }
      }
    }
  }
}
