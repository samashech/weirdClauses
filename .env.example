# Causal Language Model for per-token surprisal (-log2 p)
# Default: Qwen/Qwen2.5-0.5B (Apache 2.0, ungated, ~494M params)
# Alternative: google/gemma-2-2b (Gemma terms; requires accepting license at https://huggingface.co/google/gemma-2-2b and HF_TOKEN)
WC_LM_MODEL=Qwen/Qwen2.5-0.5B

# Sentence embedding model for baseline standard clause retrieval
# Default: sentence-transformers/all-MiniLM-L6-v2 (Apache 2.0, ungated)
WC_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cache directory for token surprisals, model files, and baseline embeddings
WC_CACHE_DIR=~/.cache/weirdclauses

# Execution device: cpu, cuda, or mps
WC_DEVICE=cpu

# Path to the baseline standard clause pack directory
WC_BASELINE_DIR=./baseline_packs/rental

# Mock mode: set to 1 to run fully offline with precomputed fixtures and zero downloads
WC_MOCK=0

# Public demo mode: set to 1 for web demo restrictions
WC_PUBLIC_DEMO=0
